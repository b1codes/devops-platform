# =============================================================================
# Terraform
# =============================================================================

# Local .terraform directories (downloaded providers and modules)
.terraform/

# State files — NEVER commit state; use a remote backend
*.tfstate
*.tfstate.*

# Crash log files generated by Terraform
crash.log
crash.*.log

# .tfvars files may contain sensitive values (secrets, account IDs, etc.)
# Use *.example.tfvars files for documentation/templates instead
*.tfvars
*.tfvars.json
!*.example.tfvars

# Override files are typically for local development only and should not be committed
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output files
*.tfplan

# Generated Lambda zip artifacts (archive_file data source in b1c-serverless-api)
.archive/
*.zip
!modules/**/fixtures/*.zip

# Transient lock info written by terraform apply (not the lock file — see below)
.terraform.tfstate.lock.info

# Terraform CLI configuration files
.terraformrc
terraform.rc

# NOTE: Do NOT ignore .terraform.lock.hcl
# The provider lock file must be committed to version control so that all
# contributors and CI runs use exactly the same provider versions.
# See: https://developer.hashicorp.com/terraform/language/files/dependency-lock

# =============================================================================
# Python
# =============================================================================

__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
.python-version

# =============================================================================
# Node.js
# =============================================================================

node_modules/
npm-debug.log
npm-debug.log.*
.npm/
dist/
build/

# =============================================================================
# macOS
# =============================================================================

.DS_Store
.AppleDouble
.LSOverride

# =============================================================================
# Editor / IDE
# =============================================================================

# JetBrains IDEs
.idea/

# VS Code — ignore workspace settings but allow shared settings examples
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json

# Vim/Neovim swap and backup files
*.swp
*.swo
*~

# =============================================================================
# CI / Local environment
# =============================================================================

# Environment variable files — never commit secrets
.env
.env.local
.env.*.local

# Generic log files
*.log
